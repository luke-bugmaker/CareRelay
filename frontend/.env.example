# Copy to .env.local and edit if needed.

# Where FastAPI runs. Leave empty to use the Vite dev proxy (recommended in dev).
# VITE_API_BASE=http://localhost:8000

# Target used by the Vite dev proxy for /api and /uploads.
# VITE_API_TARGET=http://localhost:8000

# Never call the network — always use the in-browser demo data.
# VITE_FORCE_MOCK=true

# Never fall back to demo data — surface backend errors instead (use while integrating).
# VITE_FORCE_LIVE=true

# How long to wait for the backend before falling back (ms).
# VITE_API_TIMEOUT_MS=6000
