# Copy to .env and fill in. .env is gitignored and never pushed.

# Backend
DATABASE_URL=sqlite:///./care_relay.db
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173

# AI provider — any OpenAI-compatible /chat/completions endpoint.
# Leave AI_API_KEY empty to run offline on the keyword fallback.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60

# Other providers — swap BASE_URL + MODEL, keep the same code:
#   Foundry    AI_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1  AI_MODEL=<deployment>
#              (key auth, not Entra ID — the /openai/v1 suffix is required)
#   DeepSeek   AI_BASE_URL=https://api.deepseek.com/v1          AI_MODEL=deepseek-chat
#   Qwen       AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   AI_MODEL=qwen-plus
#   Moonshot   AI_BASE_URL=https://api.moonshot.cn/v1           AI_MODEL=moonshot-v1-8k
#   OpenRouter AI_BASE_URL=https://openrouter.ai/api/v1         AI_MODEL=<vendor>/<model>
#   Ollama     AI_BASE_URL=http://localhost:11434/v1            AI_MODEL=qwen2.5  (AI_API_KEY=ollama)
